# Godot 4 editor cache and imported assets. Regenerated by:
#   godot --headless --path . --import
.godot/

# Godot 3 leftovers, Android build template, Mono/C# artifacts
.import/
/android/
.mono/
data_*/
mono_crash.*.json

# Exported builds. scripts/export/add_export_preset.gd defaults every preset to
# ../build/<platform>/ (beside the project, never inside it, so the exporter
# cannot re-import its own output); this covers a build/ inside the project too.
/build/
/builds/
*.x86_64
*.exe
*.apk
*.aab
*.ipa
*.pck
*.zip

# Generated at import time from the .csv/.po sources
*.translation

# OS junk
.DS_Store
Thumbs.db

# NOTE: export_presets.cfg is deliberately NOT ignored. On Godot 4 the script
# encryption key lives in .godot/export_credentials.cfg, not in the preset file,
# so the presets are safe to commit — and every agent that clones the repo needs
# them to run scripts/export/export_project.py.

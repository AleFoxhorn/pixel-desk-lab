{
  "name": "HI3D model integration",
  "scene_path": "scenes/lab.tscn",
  "viewport_size": {
    "width": 1280,
    "height": 720
  },
  "settle_frames": 8,
  "steps": [
    {
      "type": "wait_seconds",
      "seconds": 0.5
    },
    {
      "type": "assert",
      "assertion": "node_exists",
      "node_path": "SceneViewport/DeskWorld/GeneratedProps/Keyboard/Model/world/geometry_0"
    },
    {
      "type": "assert",
      "assertion": "node_exists",
      "node_path": "SceneViewport/DeskWorld/GeneratedProps/Lamp/Model/world/geometry_0"
    },
    {
      "type": "assert",
      "assertion": "node_exists",
      "node_path": "SceneViewport/DeskWorld/GeneratedProps/Radio/Model/world/geometry_0"
    },
    {
      "type": "assert",
      "assertion": "node_exists",
      "node_path": "SceneViewport/DeskWorld/GeneratedProps/Recorder/Model/world/geometry_0"
    },
    {
      "type": "assert",
      "assertion": "node_exists",
      "node_path": "SceneViewport/DeskWorld/GeneratedProps/Computer/Model/world/geometry_0"
    },
    {
      "type": "assert",
      "assertion": "node_exists",
      "node_path": "SceneViewport/DeskWorld/GeneratedProps/OrigamiBird/Model/world/geometry_0"
    },
    {
      "type": "spatial_report",
      "label": "hi3d_environment",
      "node_path": "SceneViewport/DeskWorld",
      "dimension": "3d",
      "max_nodes": 500,
      "expect_on_screen": [
        "SceneViewport/DeskWorld/GeneratedProps/Lamp/Model/world/geometry_0",
        "SceneViewport/DeskWorld/GeneratedProps/Radio/Model/world/geometry_0",
        "SceneViewport/DeskWorld/GeneratedProps/Recorder/Model/world/geometry_0",
        "SceneViewport/DeskWorld/GeneratedProps/Computer/Model/world/geometry_0",
        "SceneViewport/DeskWorld/GeneratedProps/OrigamiBird/Model/world/geometry_0"
      ],
      "fail_on": [
        "no_camera_3d",
        "no_light_3d",
        "not_in_frustum",
        "behind_camera"
      ],
      "path": "res://verification/hi3d_spatial.json"
    },
    {
      "type": "screenshot",
      "path": "res://verification/hi3d_environment.png",
      "expect": {
        "not_blank": true
      }
    }
  ],
  "performance_frames": 20
}
